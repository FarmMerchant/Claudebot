# --- Discord (free) -------------------------------------------------------
# https://discord.com/developers/applications
DISCORD_TOKEN=MTU0MTE3MTE5OTQ0NTMwNzQwMg.G0DZQi.h5w5PG8zZu_DLVIKjknTddIIrFQqyO3D8PbXZ8
DISCORD_CLIENT_ID=1541171199445307402
# Optional: register slash commands instantly in one server instead of globally
# (global registration can take up to an hour to show up).
DISCORD_GUILD_ID=

# --- Claude (pay-per-use) -------------------------------------------------
# https://console.anthropic.com. Leave unset if you've run `ant auth login`.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# --- Speech to text: whisper.cpp (free, runs locally) ---------------------
# Windows paths need forward slashes or doubled backslashes.
WHISPER_BIN=C:/tools/whisper/whisper-cli.exe
WHISPER_MODEL=C:/tools/whisper/models/ggml-base.en.bin
WHISPER_THREADS=4
WHISPER_LANGUAGE=en

# --- Text to speech: Piper (free, runs locally) ---------------------------
PIPER_BIN=C:/tools/piper/piper.exe
PIPER_MODEL=C:/tools/piper/en_US-amy-medium.onnx

# --- Behaviour ------------------------------------------------------------
# The default is matched loosely, so "hey clod" and "hi cloud" also work.
# Setting your own phrase here switches to exact matching.
WAKE_PHRASE=hey claude

# --- Random outbursts (free) ----------------------------------------------
# Folder of .wav files played at random. Unset disables outbursts entirely.
OUTBURST_SOUNDS_DIR=C:/Users/willi/OneDrive/Documents/Outburst sounds

# --- Text to speech --------------------------------------------------------
# kokoro (default, local neural TTS, more human) or piper (faster, robotic).
TTS_ENGINE=kokoro
# Pick a voice with: npm run voices    Audition it with: npm run say -- "hello"
KOKORO_VOICE=af_heart
# fp32 is fastest on a desktop CPU despite being the largest. See the README.
KOKORO_DTYPE=fp32
# 1 is the natural pace; 1.1-1.2 tightens up a voice that drags.
KOKORO_SPEED=1

# --- Supertonic (fast engine) ---------------------------------------------
# Folder holding onnx/ and voice_styles/, downloaded from
# https://huggingface.co/Supertone/supertonic (~255 MB).
SUPERTONIC_DIR=C:/tools/supertonic
# F1-F5 (female) or M1-M5 (male). Switch live with /voice.
SUPERTONIC_VOICE=F1
# Diffusion steps: 2 is fastest, 8 is their default. 4 is a good middle.
SUPERTONIC_STEPS=4
SUPERTONIC_SPEED=1.05

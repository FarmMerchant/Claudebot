{
  "name": "claudebot",
  "version": "1.0.0",
  "description": "Discord bot that sits in a voice channel and answers questions that start with \"Hey Claude\".",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "say": "npm run build --silent && node dist/say.js",
    "voices": "npm run build --silent && node dist/say.js --list"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@discordjs/voice": "^0.19.2",
    "@msgpack/msgpack": "^3.1.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "fft.js": "^4.0.4",
    "js-yaml": "^5.3.0",
    "kokoro-js": "^1.2.1",
    "libsodium-wrappers": "^0.8.4",
    "onnxruntime-node": "^1.21.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
